# GratisCode environment variables
# Copy this file to .env.local and fill in your values.

# Database
# PostgreSQL connection string (required for production / Vercel).
# Production on Vercel/serverless must use a pooled connection endpoint
# (PgBouncer/provider pooler/Prisma Accelerate) to avoid exhausting Postgres.
DATABASE_URL="postgresql://user:password@localhost:5432/gratiscode"

# Rate limiting (Upstash Redis)
# Required for production. Get free tier at https://upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Server-side salt for hashing IP addresses. Keep secret and rotate carefully.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT="change-this-to-a-long-random-hex-string-min-32-chars"

# Admin dashboard access
# Dev/local only. /admin always returns 404 in production until real auth exists.
ENABLE_ADMIN="false"
ADMIN_PASSWORD="change-this-admin-password"

# Optional: node environment
NODE_ENV="development"
