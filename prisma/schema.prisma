// GratisCode — Prisma schema
// SQLite is used for local/dev. Swap `provider = "sqlite"` to "postgresql"
// and update DATABASE_URL to a Postgres connection string when ready.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model WaitlistSignup {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  city               String?
  type               String
  currentTool        String?
  whyInterested      String?
  consentAt          DateTime
  createdAt          DateTime @default(now())
  source             String?
  ipHash             String?
}

model SponsorLead {
  id             String   @id @default(uuid())
  name           String
  email          String
  company        String
  budgetRange    String
  targetAudience String?
  message        String?
  consentAt      DateTime
  createdAt      DateTime @default(now())
  source         String?
  ipHash         String?
}
