// GratisCode — Prisma schema
// PostgreSQL is used for production (Vercel Postgres, Neon, Supabase, etc.).
// Set DATABASE_URL to a Postgres connection string, e.g.:
// postgresql://user:password@host:5432/db?sslmode=require

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model WaitlistSignup {
  id                 String   @id @default(uuid())
  name               String
  email              String   @unique
  city               String?
  type               String
  currentTool        String?
  whyInterested      String?
  consentAt          DateTime
  createdAt          DateTime @default(now())
  source             String?
  ipHash             String?
}

model SponsorLead {
  id             String   @id @default(uuid())
  name           String
  email          String
  company        String
  budgetRange    String
  targetAudience String?
  message        String?
  consentAt      DateTime
  createdAt      DateTime @default(now())
  source         String?
  ipHash         String?
}
