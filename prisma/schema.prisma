generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BuilderType {
  student
  indie_builder
  early_career_developer
  open_source_contributor
  hackathon_team
  other
}

enum SponsorBudgetRange {
  inr_1000
  inr_5000
  inr_25000
  inr_75000_plus
  custom
}

model WaitlistSignup {
  id             String      @id @default(uuid())
  name           String
  email          String      @unique
  city           String?
  type           BuilderType
  currentTool    String?
  whyInterested  String?
  consentAt      DateTime
  createdAt      DateTime    @default(now())
  source         String?
  ipHash         String?
}

model SponsorLead {
  id             String             @id @default(uuid())
  name           String
  email          String             @unique
  company        String
  budgetRange    SponsorBudgetRange
  targetAudience String?
  message        String?
  consentAt      DateTime
  createdAt      DateTime           @default(now())
  source         String?
  ipHash         String?
}
